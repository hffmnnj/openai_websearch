{
  "name": "openai_websearch",
  "version": "1.2.0",
  "description": "Self-hostable MCP server + reusable API client for OpenAI's native web search via ChatGPT/Codex auth. OAuth login built in, token auto-refresh. Zero API keys.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./auth": "./lib/auth.js",
    "./mcp": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "openai_websearch": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "login": "node index.js login",
    "login:device": "node index.js login --device-code",
    "auth-status": "node index.js auth-status",
    "test": "node test/client.test.js"
  },
  "keywords": [
    "openai",
    "web-search",
    "mcp",
    "codex",
    "chatgpt",
    "search",
    "image-search",
    "exa-alternative",
    "model-context-protocol"
  ],
  "author": "James Hoffmann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hffmnnj/openai_websearch.git"
  },
  "homepage": "https://github.com/hffmnnj/openai_websearch",
  "bugs": {
    "url": "https://github.com/hffmnnj/openai_websearch/issues"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  }
}
